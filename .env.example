# Copy to .env (Windows: copy .env.example .env) and change the password.
# These credentials only protect the PostgreSQL container on the private
# compose network; the database port is not published to the host.
POSTGRES_USER=ecg
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=ecg

# Host port of the web UI (http://localhost:5173).
FRONTEND_PORT=5173

# Register every WFDB record found in data/physionet at startup (idempotent).
AUTO_IMPORT_SAMPLES=1
